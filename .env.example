# PostgreSQL role/database created during setup. URL-encode special password characters.
DATABASE_URL=postgresql://caregiving_app:caregiving_local_password@127.0.0.1:5432/caregiving
REDIS_URL=redis://127.0.0.1:6379/0

# Groq is used directly for generation.
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=openai/gpt-oss-20b

# Eden AI v3 is used for pgvector retrieval. The selected model must return a
# 1536-dimension vector, and follows Eden AI's provider/model naming format.
EMBEDDING_URL=https://api.edenai.run/v3/embeddings
EMBEDDING_API_KEY=your_eden_ai_api_key_here
EMBEDDING_MODEL=openai/text-embedding-3-small
